{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "planning-director": {
      "description": "策划总经理 - 需求分析、任务拆解、PRD审核",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2
    },
    "planner": {
      "description": "策划者 - 编写PRD、用户故事、验收标准",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.3
    },
    "chief-architect": {
      "description": "总架构师 - 技术架构设计、开发任务拆解",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2
    },
    "developer": {
      "description": "开发者 - 编码实现功能",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.3
    },
    "chief-reviewer": {
      "description": "总审核者 - 代码审查管理、质量把关",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.1
    },
    "reviewer": {
      "description": "审核员 - 具体代码审查",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.1
    },
    "tester": {
      "description": "测试员 - 编写和运行测试",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-20250514",
      "temperature": 0.2
    }
  }
}
